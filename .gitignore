# ── Rust / Cargo ────────────────────────────────────────────────────────────
/target/
**/target/
/target-*/
**/*.rs.bk
*.pdb
Cargo.lock.bak

# Local Cargo overrides (machine-specific)
.cargo/config.toml.local
.cargo/config.local.toml

# ── IDE / editor ────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~

# Cursor / local agent config (often contains API keys in mcp.json)
.cursor/
.code/
.claude/

# ── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
# Accidental Windows NUL redirect artifact
/nul
/NUL

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
.venv/
venv/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
*.pyo

# Maturin / PyO3 local build debris
bindings/python/target/
bindings/python/.venv/

# ── Node / napi-rs ──────────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Native addon + packaging artifacts (built locally / CI)
*.node
*.tgz
*.whl
*.wheel

# ── Local secrets / runtime state — never commit ────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# Repo-local genATP data (profiles, vault copies, cassette dumps)
.genatp/
**/.genatp/
genatp-vault.db
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.cassette.local

# Local Chrome / CDP profiles created during tests
**/chrome-profile*/
**/genatp-profile*/
**/user-data-dir/

# direnv
.envrc
!.envrc.example
.direnv/

# ── Coverage / profiling ────────────────────────────────────────────────────
*.profraw
*.profdata
coverage/
lcov.info
tarpaulin-report.html
cobertura.xml

# ── Fuzzing ─────────────────────────────────────────────────────────────────
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# ── Misc scratch ────────────────────────────────────────────────────────────
temp.txt
*.tmp
*.temp
*.bak
*.orig
